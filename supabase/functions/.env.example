# Server-side only. Never put these values in a VITE_* variable.
# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.
# Single origin or comma-separated origins. Preserve all existing production
# entries when updating this secret. http://localhost:5174 is always allowed.
QUIZ_ADMIN_ORIGIN=http://localhost:5174
QUIZ_N8N_WEBHOOK_URL=
QUIZ_N8N_WEBHOOK_SECRET=
QUIZ_WORKER_SECRET=
OPENAI_API_KEY=
# Use a Responses API model supporting strict structured outputs.
QUIZ_OPENAI_MODEL=
QUIZ_OPENAI_REVIEW_MODEL=
